{
  "name": "aramisauto/liform-bundle",
  "description": "Liform library and its Symfony bundle: transform Symfony Forms into JSON Schema",
  "type": "symfony-bundle",
  "license": "MIT",
  "authors": [
    {
      "name": "Nacho Martín",
      "email": "nacho@limenius.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Limenius\\Liform\\": "src/Liform/",
      "Limenius\\LiformBundle\\": "src/LiformBundle/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Limenius\\Liform\\Tests\\": "tests/Liform/"
    }
  },
  "require": {
    "php": ">=8.2",
    "symfony/config": "^6.4|^7.1|^8.0",
    "symfony/dependency-injection": "^7.1|^8.0",
    "symfony/form": "^6.4|^7.1|^8.0",
    "symfony/http-kernel": "^6.4|^7.1|^8.0",
    "symfony/serializer": "^6.4|^7.1|^8.0",
    "symfony/translation": "^6.4|^7.1|^8.0",
    "symfony/translation-contracts": "^2.1|^3.0",
    "symfony/validator": "^6.4|^7.1|^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.4|^12.0"
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "stable"
}
